{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aquasee-website",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": ".open-next/worker.js",
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // One-click unsubscribe records. Create with: npx wrangler kv namespace create
  // UNSUBSCRIBE_KV — then paste the returned id below.
  "kv_namespaces": [
    {
      "binding": "UNSUBSCRIBE_KV",
      "id": "b55b5b9a3bc14db6876084b5f5ef91a0"
    }
  ],
  "observability": {
    "enabled": true
  },
  // Every page request is rendered inside the Worker, and a crawl that
  // arrives in parallel could push it past the default 128 MB and answer
  // with a 503. Four times the room removes that.
  "limits": {
    "memory_mb": 512
  },
  "workers_dev": true,
  "routes": [
    { "pattern": "www.aquasee.art", "custom_domain": true },
    { "pattern": "aquasee.art", "custom_domain": true }
  ]
}
