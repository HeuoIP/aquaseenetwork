{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aquasee-website",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": ".open-next/worker.js",
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // One-click unsubscribe records. Create with: npx wrangler kv namespace create
  // UNSUBSCRIBE_KV — then paste the returned id below.
  "kv_namespaces": [
    {
      "binding": "UNSUBSCRIBE_KV",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ],
  "observability": {
    "enabled": true
  },
  "workers_dev": true,
  "routes": [
    { "pattern": "www.aquasee.art", "custom_domain": true },
    { "pattern": "aquasee.art", "custom_domain": true }
  ]
}
