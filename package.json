{
  "name": "aquasee-website",
  "version": "1.0.0",
  "private": true,
  "description": "AQUASEE — overseas business website (Strategy. Creative Design. Project Realization.)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "build:opennext": "opennextjs-cloudflare build",
    "preview:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "setup:mail": "node scripts/set-mail-secrets.mjs",
    "deploy:cloudflare": "opennextjs-cloudflare build && wrangler deploy",
    "deploy:cloudflare:dry": "opennextjs-cloudflare build && wrangler deploy --dry-run",
    "geo:check": "node scripts/geo/struct-check.mjs",
    "geo:audit": "node scripts/geo/answer-audit.mjs",
    "geo:serp": "node scripts/geo/serp-track.mjs",
    "geo:scorecard": "node scripts/geo/scorecard.mjs",
    "geo:runtime": "node scripts/geo/preview-check.mjs",
    "research:demand": "node scripts/research/demand.mjs",
    "research:serp": "node scripts/research/serp-map.mjs"
  },
  "dependencies": {
    "next": "16.4.2",
    "nodemailer": "10.2.1",
    "playwright-core": "^1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.13",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.31",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "wrangler": "4.152.0"
  }
}
